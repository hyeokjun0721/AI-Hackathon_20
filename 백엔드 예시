# 3. [T04, T05, E] 정규화 및 검수 필드 관리 함수
def normalize_and_verify(raw_data):
    normalized_sizes = {}
    
    for size_name, metrics in raw_data["raw_sizes"].items():
        norm = {}
        # 동료 스키마 [E]: 검수 상태 초기화
        norm["verification_status"] = "검수 완료"
        norm["checked_at"] = datetime.now().strftime("%Y-%m-%d")
        
        try:
            # 1. 어깨너비 정규화 (T04: mm -> cm)
            sh_val = str(metrics.get("shoulder_cm", "")).strip()
            if not sh_val or sh_val in ["-", "미제공"]:
                raise ValueError("어깨너비 누락")
            norm["shoulder_cm"] = float(sh_val.replace("mm", "")) / 10.0 if "mm" in sh_val else float(sh_val.replace("cm", ""))
            
            # 2. 가슴단면 정규화 (T04: 둘레 -> 단면)
            ch_val = str(metrics.get("chest_width_cm", "")).strip()
            if not ch_val or ch_val in ["-", "미제공"]:
                raise ValueError("가슴단면 누락")
            if "둘레" in ch_val:
                clean_num = float(ch_val.replace("가슴둘레", "").replace("cm", "").strip())
                norm["chest_width_cm"] = clean_num / 2.0
            else:
                norm["chest_width_cm"] = float(ch_val.replace("cm", "").strip())
                
            # 3. 총장 정규화
            l_val = str(metrics.get("length_cm", "")).strip()
            if not l_val or l_val in ["-", "미제공"]:
                raise ValueError("총장 누락")
            norm["length_cm"] = float(l_val.replace("cm", ""))
            
            # 4. 소매길이 정규화
            sl_val = str(metrics.get("sleeve_cm", "")).strip()
            norm["sleeve_cm"] = float(sl_val.replace("cm", "")) if sl_val and sl_val not in ["-"] else None

        except ValueError as e:
            # 동료 규칙 [T05]: 필수값 누락 시 임의 0cm 추정 금지 -> 검수 필요 상태 변경
            norm["verification_status"] = f"검수 필요 ({str(e)})"
            
        normalized_sizes[size_name] = norm
        
    return normalized_sizes

# 4. [T07] 사이즈 추천 엔진 함수
def recommend_size(user_ref, normalized_sizes):
    my_meas = user_ref["measurements"]
    best_size = None
    min_diff = 999.0
    
    for size_name, dims in normalized_sizes.items():
        # 검수 실패한 사이즈(T05)는 추천 대상에서 제외
        if dims["verification_status"] != "검수 완료":
            continue
            
        diff = abs(dims["shoulder_cm"] - my_meas["shoulder_cm"]) + abs(dims["length_cm"] - my_meas["length_cm"])
        if diff < min_diff:
            min_diff = diff
            best_size = size_name
            
    if not best_size:
        return {"error": "T08: 적합한 추천 사이즈를 찾을 수 없음"}
        
    target_best = normalized_sizes[best_size]
    
    return {
        "source_url": user_ref["reference_url"],
        "recommended_size": best_size,
        "diff_details": {
            "shoulder_cm": f"{target_best['shoulder_cm'] - my_meas['shoulder_cm']:+.1f}cm",
            "length_cm": f"{target_best['length_cm'] - my_meas['length_cm']:+.1f}cm",
            "chest_width_cm": f"{target_best['chest_width_cm'] - my_meas['chest_width_cm']:+.1f}cm"
        },
        "verification_status": target_best["verification_status"]
    }

# 5. 파이프라인 실행
clean_sizes = normalize_and_verify(raw_extracted_data)

print("📌 [1. T04/T05 정규화 및 검수 완료 데이터]:")
print(json.dumps(clean_sizes, ensure_ascii=False, indent=2))

final_result = recommend_size(user_reference_clothes, clean_sizes)

print("\n==========================================")
print(f"🎉 [2. T07 최종 추천 결과]: {final_result['recommended_size']}")
print(f"👉 상세 오차: {final_result['diff_details']}")
print("==========================================")
